JWT_SECRET_KEY=change-me-to-a-long-random-secret
REDIS_URL=redis://localhost:6379/0
# Docker Compose overrides this to redis://redis:6379/0 for api and worker services
ARQ_QUEUE_NAME=security-demo
ARQ_MAX_JOBS=5
APP_ENV=development
# Include your Vercel URL in production, e.g. https://my-app.vercel.app
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000
DATABASE_URL=sqlite:///./app.db
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/oauth/github/callback

# S3 / MinIO (local dev with Docker MinIO on port 9000)
S3_BUCKET_NAME=security-demo-attachments
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_SUCCESS_URL=http://127.0.0.1:8000/billing/success
STRIPE_CANCEL_URL=http://127.0.0.1:8000/billing/cancel
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# GitHub webhook secret (from repo Settings → Webhooks)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# Notifications microservice (Compose overrides to http://notifications:8001)
NOTIFICATIONS_URL=http://localhost:8001
